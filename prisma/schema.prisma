// Prisma schema for Pokedex auth + favorites
datasource db {
  provider = "mysql" // can switch to postgres later
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  favorites Favorite[] // relation
}

model Favorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  pokemonName String
  createdAt DateTime @default(now())

  @@unique([userId, pokemonName]) // prevent duplicate favorites per user
}
